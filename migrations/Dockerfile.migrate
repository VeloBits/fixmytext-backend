FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir \
    alembic \
    asyncpg \
    "sqlalchemy[asyncio]" \
    pgvector \
    pydantic-settings \
    httpx
COPY migrations/ ./migrations/
COPY services/payments-svc/ ./services/payments-svc/
COPY shared/ ./shared/
RUN pip install --no-cache-dir -e ./shared
