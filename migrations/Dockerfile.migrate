FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir \
    alembic \
    asyncpg \
    "sqlalchemy[asyncio]" \
    pgvector \
    pydantic-settings \
    "pydantic[email]" \
    httpx \
    razorpay
COPY migrations/ ./migrations/
COPY services/payments-svc/ ./services/payments-svc/
# account-svc source needed so migrations/env.py can import activity-schema models
COPY services/account-svc/ ./services/account-svc/
COPY shared/ ./shared/
RUN pip install --no-cache-dir -e ./shared

# Run migrations as a non-root user (DO-06). Alembic only needs DB access +
# read access to /app (root-owned files are world-readable), not root.
RUN useradd --create-home --uid 10001 migrate
USER migrate
