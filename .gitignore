# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  FixMyText - backend/.gitignore (Python / FastAPI)                          │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment files (never commit secrets) ──────────────────────────────────
# Env files. `.env.bak` and friends hold the same live secrets as `.env` —
# a bare `.env` pattern does not cover them, and one `git add -A` is all it
# takes. Ignore the whole family and re-include the committed example.
.env
.env.*
!.env.example

# Local agent/tooling scratch state (ruflo / ruvector containers + locks).
agentdb.rvf
agentdb.rvf.lock
*.rvf
*.rvf.lock

# ── Distribution / packaging ──────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.egg

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json
*.coveragerc

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── Linting ───────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Database ─────────────────────────────────────────────────────────────────
*.db
data/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/

# ── AI Files ─────────────────────────────────────────────────────────
*.ai
.claude*

# ── Secrets directory (keep structure, ignore contents) ──────────────
secrets/*
!secrets/.gitkeep 