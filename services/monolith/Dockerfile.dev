# Development — minimal single-stage image.
# Source code is mounted as a volume; uvicorn --reload watches for changes.
#
# The venv lives on a *named* volume in docker-compose (see Dockerfile.dev's
# /app/.venv mount). On every container start, dev-entrypoint.sh hashes
# requirements.txt and re-runs pip install only when it changed — so editing
# requirements.txt on the host is enough; no `--renew-anon-volumes` dance.

FROM python:3.14-slim

WORKDIR /app

# Pre-build the venv at image-build time so first-run is fast even before
# the entrypoint's hash check runs. The entrypoint will reuse this venv on
# the named volume's first attach (or rebuild it on a fresh volume).
RUN python -m venv .venv
# Build context is backend root so both shared/ and services/monolith/ are accessible.
COPY services/monolith/requirements.txt .
COPY shared/ ./shared/
RUN .venv/bin/pip install --upgrade pip --quiet && \
    .venv/bin/pip install --no-cache-dir -r requirements.txt && \
    sha256sum requirements.txt | awk '{print $1}' > /app/.venv/.requirements.hash

# Make venv binaries the default for any RUN/CMD/ENTRYPOINT.
ENV PATH="/app/.venv/bin:$PATH"

# Sync deps on every start, then exec whatever was passed (uvicorn or alembic).
COPY services/monolith/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
