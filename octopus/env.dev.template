# Octopus environment template for the DEVELOPMENT stack
# (docker-compose.yml + octopus/docker-compose.deploy.yml).
# The Production stack has its own template: octopus/env.prod.template.
#
# Octopus substitutes the tokens below ("Substitute Variables in Templates"
# feature), then octopus/deploy.sh copies this file to <package root>/.env with
# mode 600 when deploying to the Development environment.
#
# Every token maps 1:1 to an Octopus PROJECT VARIABLE of the same name, scoped
# to the Development environment. Mark passwords, keys and secrets as SENSITIVE
# in Octopus. Variable table: docs/octopus-setup.md (Stage D).
#
# Tokens wrapped in an "if" block are OPTIONAL: they render empty when the
# variable is not defined and the stack degrades gracefully (compose defaults
# apply, integrations stay off). Bare tokens are REQUIRED — deploy.sh aborts on
# any token left unsubstituted.
#
# This is NOT a copy of .env.example. .env.example is the local-laptop contract
# (localhost, in-compose Postgres); this file is the deployed contract (public
# hostnames, remote database, strict cookies).

# ── Deployment identity (REQUIRED) ───────────────────────────────────────────
# Prefixes compose volume/label names — keep it stable or volumes orphan.
COMPOSE_PROJECT_NAME=#{COMPOSE_PROJECT_NAME}

# Development stack keeps dev semantics on purpose: this environment exists to
# exercise the deploy path, not to be production-strict. The startup guards
# (issuer required, proxy trust, cookie Secure) are therefore not enforced by
# ENVIRONMENT here — the values below set them correctly anyway.
ENVIRONMENT=development
SENTRY_ENVIRONMENT=development

# ── Product database — remote managed Postgres (REQUIRED, sensitive) ─────────
# The VM runs NO database container: db-service and pgbouncer are parked behind
# the `local-db` profile by octopus/docker-compose.deploy.yml. Use the DEV
# database on the managed service, separate from prod's.
# asyncpg form, and asyncpg spells TLS `ssl=require` (NOT libpq's sslmode=):
#   postgresql+asyncpg://<user>:<pass>@<host>:<port>/fixmytext_dev?ssl=require
DATABASE_URL=#{DATABASE_URL}
# Only consumed by the parked local-db fallback, but compose interpolates the
# whole file before profiles are applied, so it must still resolve.
POSTGRES_PASSWORD=#{POSTGRES_PASSWORD}

# ── Redis (REQUIRED, sensitive) ──────────────────────────────────────────────
# Runs on the VM. REDIS_URL must embed the same password.
REDIS_PASSWORD=#{REDIS_PASSWORD}
REDIS_URL=redis://:#{REDIS_PASSWORD}@redis-service:6379/0

# ── Keycloak (REQUIRED; service-account secret is sensitive) ─────────────────
# Two different addresses, deliberately:
#   KEYCLOAK_URL / KEYCLOAK_JWKS_URL  server-to-server → the INTERNAL container
#     name on velobits-proxy-net. The public name resolves through Cloudflare
#     and its certificate is not in these images' trust store.
#   KEYCLOAK_ISSUER  the browser-facing realm URL, because that is what
#     Keycloak stamps into the token's `iss` claim.
# Realm + service account are provisioned by velobits-infra's bootstrap.sh —
# KEYCLOAK_SERVICE_ACCOUNT_* MUST match that repo's Octopus variables.
KEYCLOAK_URL=http://keycloak-dev:8080
KEYCLOAK_REALM=#{KEYCLOAK_REALM}
KEYCLOAK_AUDIENCE=#{KEYCLOAK_AUDIENCE}
KEYCLOAK_JWKS_URL=http://keycloak-dev:8080/realms/#{KEYCLOAK_REALM}/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://auth-dev.velobits.dev/realms/#{KEYCLOAK_REALM}
KEYCLOAK_CLIENT_ID=#{KEYCLOAK_AUDIENCE}
KEYCLOAK_SERVICE_ACCOUNT_ID=#{if KEYCLOAK_SERVICE_ACCOUNT_ID}#{KEYCLOAK_SERVICE_ACCOUNT_ID}#{/if}
KEYCLOAK_SERVICE_ACCOUNT_SECRET=#{if KEYCLOAK_SERVICE_ACCOUNT_SECRET}#{KEYCLOAK_SERVICE_ACCOUNT_SECRET}#{/if}
JWT_ALGORITHM=RS256

# ── Application secrets (REQUIRED, all sensitive) ────────────────────────────
# Generate each with: openssl rand -base64 48
SECRET_KEY=#{SECRET_KEY}
SESSION_COOKIE_SECRET=#{SESSION_COOKIE_SECRET}
# Guards the service-to-service entitlement endpoints; empty fails CLOSED.
INTERNAL_SHARED_SECRET=#{INTERNAL_SHARED_SECRET}

# ── Session cookie ───────────────────────────────────────────────────────────
# Served over HTTPS via Traefik, so Secure is mandatory. Host-only Domain: the
# API and the frontend are different hosts and a shared parent Domain would
# widen the cookie for no gain. (No inline comments — for an empty value the
# compose env_file parser would keep the comment AS the value.)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=fixmytext_session
SESSION_COOKIE_MAX_AGE=604800
SESSION_COOKIE_DOMAIN=

# ── Proxy trust (REQUIRED) ───────────────────────────────────────────────────
# Kong is the only upstream, and it reaches services on the private network
# whose subnet octopus/docker-compose.deploy.yml pins to 172.29.0.0/16. A "*"
# here would let any caller spoof X-Forwarded-For and bypass the rate limiter.
TRUSTED_PROXY_HOSTS=172.29.0.0/16

# ── Public URLs ──────────────────────────────────────────────────────────────
# API is api-dev.fixmytext.velobits.dev (Traefik → kong:8000); the values below
# are what the BACKEND needs to know about the frontend for links and CORS.
FRONTEND_URL=https://fixmytext-dev.velobits.dev
ALLOWED_ORIGINS=["https://fixmytext-dev.velobits.dev","https://fixmytext-dev-editor.velobits.dev","https://fixmytext-dev-analytics.velobits.dev","https://fixmytext-dev-content.velobits.dev","https://fixmytext-dev-shell.velobits.dev"]

# ── Third-party APIs (REQUIRED, sensitive) ───────────────────────────────────
GROQ_API_KEY=#{GROQ_API_KEY}
RAZORPAY_KEY_ID=#{RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=#{RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=#{RAZORPAY_WEBHOOK_SECRET}

# ── Free-tier limits (optional — compose/service defaults apply) ─────────────
FREE_USES_PER_TOOL_PER_DAY=#{if FREE_USES_PER_TOOL_PER_DAY}#{FREE_USES_PER_TOOL_PER_DAY}#{/if}
DAILY_LOGIN_BONUS=#{if DAILY_LOGIN_BONUS}#{DAILY_LOGIN_BONUS}#{/if}

# ── Email (optional — blank host disables sending) ───────────────────────────
EMAIL_BACKEND=#{if EMAIL_BACKEND}#{EMAIL_BACKEND}#{/if}
SMTP_HOST=#{if SMTP_HOST}#{SMTP_HOST}#{/if}
SMTP_PORT=#{if SMTP_PORT}#{SMTP_PORT}#{/if}
SMTP_USE_TLS=#{if SMTP_USE_TLS}#{SMTP_USE_TLS}#{/if}
SMTP_USERNAME=#{if SMTP_USERNAME}#{SMTP_USERNAME}#{/if}
SMTP_PASSWORD=#{if SMTP_PASSWORD}#{SMTP_PASSWORD}#{/if}
EMAIL_FROM=#{if EMAIL_FROM}#{EMAIL_FROM}#{/if}

# ── Observability (optional — blank disables the exporter) ───────────────────
SENTRY_DSN=#{if SENTRY_DSN}#{SENTRY_DSN}#{/if}
SENTRY_TRACES_SAMPLE_RATE=#{if SENTRY_TRACES_SAMPLE_RATE}#{SENTRY_TRACES_SAMPLE_RATE}#{/if}
SENTRY_RELEASE=#{if SENTRY_RELEASE}#{SENTRY_RELEASE}#{/if}
OTEL_EXPORTER_OTLP_ENDPOINT=#{if OTEL_EXPORTER_OTLP_ENDPOINT}#{OTEL_EXPORTER_OTLP_ENDPOINT}#{/if}
OTEL_EXPORTER_OTLP_HEADERS=#{if OTEL_EXPORTER_OTLP_HEADERS}#{OTEL_EXPORTER_OTLP_HEADERS}#{/if}
