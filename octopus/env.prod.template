# Octopus environment template for the PRODUCTION stack
# (docker-compose-prod.yml — api.fixmytext.velobits.dev).
# The Development stack has its own template: octopus/env.dev.template.
#
# Octopus substitutes the tokens below ("Substitute Variables in Templates"
# feature), then octopus/deploy.sh copies this file to <package root>/.env with
# mode 600 when deploying to the Production environment.
#
# Every token maps 1:1 to an Octopus PROJECT VARIABLE of the same name, scoped
# to the Production environment. Mark passwords, keys and secrets as SENSITIVE.
# Variable table: docs/octopus-deployment.md.
#
# ENVIRONMENT=production turns on every startup guard in the services: each one
# refuses to boot on an empty KEYCLOAK_ISSUER / KEYCLOAK_AUDIENCE /
# SESSION_COOKIE_SECRET / INTERNAL_SHARED_SECRET, on TRUSTED_PROXY_HOSTS="*",
# on SESSION_COOKIE_SECURE=false, and on any "fake" backend. A deploy that is
# missing one of these fails loudly at container start rather than serving
# traffic with a check silently disabled — that is the intent, do not soften it.

# ── Deployment identity (REQUIRED) ───────────────────────────────────────────
# Prefixes compose volume names — keep it stable or volumes orphan.
COMPOSE_PROJECT_NAME=#{COMPOSE_PROJECT_NAME}
ENVIRONMENT=production
SENTRY_ENVIRONMENT=production

# ── Product database — remote managed Postgres (REQUIRED, sensitive) ─────────
# The VM runs no database container (db-service sits behind the `local-db`
# profile as an escape hatch only). Use the PROD database on the managed
# service, separate from dev's.
# asyncpg form, and asyncpg spells TLS `ssl=require` (NOT libpq's sslmode=):
#   postgresql+asyncpg://<user>:<pass>@<host>:<port>/fixmytext_prod?ssl=require
DATABASE_URL=#{DATABASE_URL}
# Only consumed by the parked local-db fallback, but compose interpolates the
# whole file before profiles are applied, so it must still resolve.
POSTGRES_PASSWORD=#{POSTGRES_PASSWORD}
# Per-service SQLAlchemy pool. Two services share the managed instance's
# connection cap, so keep the product of (services x (pool + overflow)) under it.
DB_POOL_SIZE=#{if DB_POOL_SIZE}#{DB_POOL_SIZE}#{/if}
DB_MAX_OVERFLOW=#{if DB_MAX_OVERFLOW}#{DB_MAX_OVERFLOW}#{/if}

# ── Redis (REQUIRED, sensitive) ──────────────────────────────────────────────
REDIS_PASSWORD=#{REDIS_PASSWORD}
REDIS_URL=redis://:#{REDIS_PASSWORD}@redis-service:6379/0

# ── Keycloak (REQUIRED; service-account secret is sensitive) ─────────────────
# Internal name for server-to-server (JWKS + Admin API), public realm URL for
# the expected `iss` claim. The prod identity container is `velobits-auth`
# (velobits-infra/docker-compose-prod.yml) on velobits-proxy-net.
# KEYCLOAK_SERVICE_ACCOUNT_* is provisioned per
# velobits-infra/docs/keycloak-production-setup.md — prod has no bootstrap
# sidecar, so create the client before the first deploy.
KEYCLOAK_URL=http://velobits-auth:8080
KEYCLOAK_REALM=#{KEYCLOAK_REALM}
KEYCLOAK_AUDIENCE=#{KEYCLOAK_AUDIENCE}
KEYCLOAK_JWKS_URL=http://velobits-auth:8080/realms/#{KEYCLOAK_REALM}/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://auth.velobits.dev/realms/#{KEYCLOAK_REALM}
KEYCLOAK_CLIENT_ID=#{KEYCLOAK_AUDIENCE}
KEYCLOAK_SERVICE_ACCOUNT_ID=#{KEYCLOAK_SERVICE_ACCOUNT_ID}
KEYCLOAK_SERVICE_ACCOUNT_SECRET=#{KEYCLOAK_SERVICE_ACCOUNT_SECRET}
JWT_ALGORITHM=RS256

# ── Application secrets (REQUIRED, all sensitive) ────────────────────────────
# MUST differ from the Development values. Generate: openssl rand -base64 48
SECRET_KEY=#{SECRET_KEY}
SESSION_COOKIE_SECRET=#{SESSION_COOKIE_SECRET}
INTERNAL_SHARED_SECRET=#{INTERNAL_SHARED_SECRET}

# ── Session cookie ───────────────────────────────────────────────────────────
# Secure is enforced by the startup guard; compose pins it too. Host-only
# Domain. (No inline comments — for an empty value the compose env_file parser
# would keep the comment AS the value.)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=fixmytext_session
SESSION_COOKIE_MAX_AGE=604800
SESSION_COOKIE_DOMAIN=

# ── Proxy trust (REQUIRED) ───────────────────────────────────────────────────
# Kong is the only upstream and reaches services on the private network, whose
# subnet docker-compose-prod.yml pins to 172.28.0.0/16. The startup guard
# rejects "*" outright in production.
TRUSTED_PROXY_HOSTS=172.28.0.0/16

# ── Public URLs ──────────────────────────────────────────────────────────────
# API is api.fixmytext.velobits.dev (Traefik → kong-prod:8000). These tell the
# backend where the frontend lives, for email/share links and the CORS fallback.
FRONTEND_URL=https://fixmytext.velobits.dev
ALLOWED_ORIGINS=["https://fixmytext.velobits.dev"]

# ── Third-party APIs (REQUIRED, sensitive) ───────────────────────────────────
# Razorpay: LIVE keys here (rzp_live_…), not the rzp_test_ pair from dev. The
# webhook endpoint to register is
# https://api.fixmytext.velobits.dev/api/v1/subscription/webhook
GROQ_API_KEY=#{GROQ_API_KEY}
RAZORPAY_KEY_ID=#{RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=#{RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=#{RAZORPAY_WEBHOOK_SECRET}

# ── Free-tier limits (optional — service defaults apply) ─────────────────────
FREE_USES_PER_TOOL_PER_DAY=#{if FREE_USES_PER_TOOL_PER_DAY}#{FREE_USES_PER_TOOL_PER_DAY}#{/if}
DAILY_LOGIN_BONUS=#{if DAILY_LOGIN_BONUS}#{DAILY_LOGIN_BONUS}#{/if}

# ── Email (REQUIRED in prod — verification mail is part of signup) ───────────
EMAIL_BACKEND=#{EMAIL_BACKEND}
SMTP_HOST=#{SMTP_HOST}
SMTP_PORT=#{SMTP_PORT}
SMTP_USE_TLS=#{if SMTP_USE_TLS}#{SMTP_USE_TLS}#{/if}
SMTP_USERNAME=#{SMTP_USERNAME}
SMTP_PASSWORD=#{SMTP_PASSWORD}
EMAIL_FROM=#{EMAIL_FROM}

# ── Observability (optional — blank disables the exporter) ───────────────────
SENTRY_DSN=#{if SENTRY_DSN}#{SENTRY_DSN}#{/if}
SENTRY_TRACES_SAMPLE_RATE=#{if SENTRY_TRACES_SAMPLE_RATE}#{SENTRY_TRACES_SAMPLE_RATE}#{/if}
SENTRY_RELEASE=#{if SENTRY_RELEASE}#{SENTRY_RELEASE}#{/if}
OTEL_EXPORTER_OTLP_ENDPOINT=#{if OTEL_EXPORTER_OTLP_ENDPOINT}#{OTEL_EXPORTER_OTLP_ENDPOINT}#{/if}
OTEL_EXPORTER_OTLP_HEADERS=#{if OTEL_EXPORTER_OTLP_HEADERS}#{OTEL_EXPORTER_OTLP_HEADERS}#{/if}
