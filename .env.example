# Backend environment variables
# Copy this file to .env (git-ignored) and adjust values as needed.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS - comma-separated list of allowed origins.
# Kong owns CORS at the edge (gateway/kong/kong.yml) for browser traffic; this
# list is the per-service FastAPI fallback for direct hits (Swagger, curl).
# Keep the two in sync when adding a frontend origin.
ALLOWED_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100","https://fixmytext-dev.velobits.dev"]

# Groq API key for AI-powered hashtag generation (free at console.groq.com)
GROQ_API_KEY=

# Auth / JWT - REQUIRED, no default. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Razorpay ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys for development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret - set up at https://dashboard.razorpay.com/app/webhooks
# Endpoint URL: https://yourdomain.com/api/v1/subscription/webhook
# Events: payment.captured, subscription.charged, subscription.cancelled, subscription.halted
RAZORPAY_WEBHOOK_SECRET=

# Free tier limits
FREE_USES_PER_TOOL_PER_DAY=3
DAILY_LOGIN_BONUS=1

# Frontend URL - used in emails and share links, so it must be browser-reachable.
#   local     http://localhost:3100
#   dev       https://fixmytext-dev.velobits.dev
#   prod      https://fixmytext.velobits.dev
FRONTEND_URL=http://localhost:3100

# ── Email (dev) ──────────────────────────────────────────────────────
#   https://myaccount.google.com/apppasswords). Sends to real inboxes.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=<16-char app password, no spaces>
EMAIL_FROM=FixMyText <you@gmail.com>

# Redis - requirepass is now mandatory. Generate: openssl rand -base64 24
REDIS_PASSWORD=
# REDIS_URL must include the password: redis://:${REDIS_PASSWORD}@redis-service:6379/0
REDIS_URL=redis://:CHANGE_ME@redis-service:6379/0

# Database - REQUIRED, no default.
# Use localhost for local dev, db-service for Docker
DATABASE_URL=postgresql+asyncpg://fixmytext:fixmytext_dev@db-service:5432/fixmytext

# Optional: route through PgBouncer for connection pooling
# PGBOUNCER_URL=postgresql+asyncpg://fixmytext:fixmytext_dev@pgbouncer:6432/fixmytext

# PostgreSQL password (must match DATABASE_URL and docker-compose.yml)
POSTGRES_PASSWORD=fixmytext_dev

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# OpenTelemetry / Grafana Cloud (log shipping to Loki via OTLP HTTP)
# Get these from Grafana Cloud → Connections → Add new connection → OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
# Format: Authorization=Basic%20<base64-encoded-username:apikey>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=fixmytext-backend

# ── JWT algorithm dispatcher ────────────────────────────────────────────────
# JWT_ALGORITHM=RS256 - production cutover happened in Sprint 4. HS256 is the
# legacy fallback path; not used.
JWT_ALGORITHM=RS256

# ── Session cookie ──────────────────────────────────────────────
# Per-app, host-only HttpOnly cookie set by account-svc on successful auth.
# HMAC-SHA256 signed with SESSION_COOKIE_SECRET. The cookie is the
# cross-framework session marker (Vite + Next.js both send it).
# Generate: openssl rand -base64 48
SESSION_COOKIE_SECRET=
SESSION_COOKIE_NAME=fixmytext_session
# NOTE: no inline `# comments` on these lines. For an EMPTY value the compose
# env_file parser keeps the comment as the value (SESSION_COOKIE_DOMAIN would
# literally become "# empty = host-only"), which then lands in the Set-Cookie
# Domain attribute. Comments go above the line.
# SESSION_COOKIE_SECURE: must be true in production (HTTPS only) - guarded at startup.
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_MAX_AGE: 7 days.
SESSION_COOKIE_MAX_AGE=604800
# SESSION_COOKIE_DOMAIN: empty = host-only (intentional).
SESSION_COOKIE_DOMAIN=

# ── Proxy trust ──────────────────────────────────────────────────────────────
# Comma-separated CIDRs or IPs trusted to supply X-Forwarded-For.
# Dev default "*" is safe because Kong is the only entry point on localhost.
# PRODUCTION: set to Kong's internal subnet CIDR (e.g. "172.20.0.0/16").
# The startup guard rejects "*" in production.
TRUSTED_PROXY_HOSTS=*

# ── Keycloak (Velobits realm) - local development ────────────────────────────
# Keycloak runs in the VeloBits/velobits-infra stack (start it first). Two
# different addresses, on purpose:
#
#   KEYCLOAK_URL / KEYCLOAK_JWKS_URL  server-to-server, so use the INTERNAL
#     name keycloak-dev:8080 over velobits-proxy-net. The public
#     auth-dev.velobits.dev name resolves to Cloudflare from inside a container
#     (not to your local Traefik), and its mkcert cert is not in the service
#     images' trust store - both make a public URL fail here.
#
#   KEYCLOAK_ISSUER  the value Keycloak puts in the token's `iss` claim, which
#     is derived from the hostname the BROWSER used. Leave it empty locally:
#     KC_HOSTNAME_STRICT=false means the issuer differs between
#     https://auth-dev.velobits.dev and http://localhost:8080, and an empty
#     value skips the check. Deployed environments MUST set it - each service's
#     startup guard refuses to boot without it when ENVIRONMENT != development.
#     Dev:  https://auth-dev.velobits.dev/realms/Velobits
#     Prod: https://auth.velobits.dev/realms/Velobits-Prod
KEYCLOAK_URL=http://keycloak-dev:8080
KEYCLOAK_REALM=Velobits
KEYCLOAK_AUDIENCE=fixmytext-backend
KEYCLOAK_JWKS_URL=http://keycloak-dev:8080/realms/Velobits/protocol/openid-connect/certs
KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID: used by send_verification_email redirect link.
KEYCLOAK_CLIENT_ID=fixmytext-backend

# Dedicated service account for Admin API calls (preferred over master admin).
# bootstrap.sh in velobits-infra creates this client - the ID + SECRET here
# MUST match the values in velobits-infra's .env.
KEYCLOAK_SERVICE_ACCOUNT_ID=account-svc
KEYCLOAK_SERVICE_ACCOUNT_SECRET=

# Fallback master admin creds (only used when the service account is not
# configured). Must match KEYCLOAK_DEV_ADMIN_USER/PASSWORD in velobits-infra.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak admin/DB passwords, social login OAuth apps (Google/GitHub), realm
# SMTP, and the backchannel logout registration all moved to the
# VeloBits/velobits-infra repo's .env - configure them there.

# ── Deployed environments (Development / Production on the Oracle VM) ────────
# Do NOT copy this file to a server. Deployed .env files are RENDERED PER
# DEPLOY by Octopus from octopus/env.dev.template and octopus/env.prod.template,
# whose tokens map 1:1 to Octopus sensitive variables. Those templates are the
# authoritative list of what each environment needs; this file is the local-dev
# contract only. The variable table for each environment is in
# docs/octopus-setup.md (Stage D); operations in docs/octopus-deployment.md.
#
# The values that genuinely differ there:
#   ENVIRONMENT=production      turns on the startup guards below
#   KEYCLOAK_ISSUER=...         required once ENVIRONMENT != development
#   TRUSTED_PROXY_HOSTS=<cidr>  "*" is rejected in production
#   SESSION_COOKIE_SECURE=true  required in production
#   DATABASE_URL=...            remote managed Postgres (Aiven), not db-service
