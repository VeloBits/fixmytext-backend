# Backend environment variables
# Copy this file to .env (git-ignored) and adjust values as needed.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Groq API key for AI-powered hashtag generation (free at console.groq.com)
GROQ_API_KEY=

# Auth / JWT — REQUIRED, no default. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Razorpay ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys for development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set up at https://dashboard.razorpay.com/app/webhooks
# Endpoint URL: https://yourdomain.com/api/v1/subscription/webhook
# Events: payment.captured, subscription.charged, subscription.cancelled, subscription.halted
RAZORPAY_WEBHOOK_SECRET=

# Free tier limits
FREE_USES_PER_TOOL_PER_DAY=3
DAILY_LOGIN_BONUS=1

# Frontend URL
FRONTEND_URL=http://localhost:3000

# ── Email (dev) ──────────────────────────────────────────────────────
#   https://myaccount.google.com/apppasswords). Sends to real inboxes.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=<16-char app password, no spaces>
EMAIL_FROM=FixMyText <you@gmail.com>

# Redis — requirepass is now mandatory. Generate: openssl rand -base64 24
REDIS_PASSWORD=
# REDIS_URL must include the password: redis://:${REDIS_PASSWORD}@redis-service:6379/0
REDIS_URL=redis://:CHANGE_ME@redis-service:6379/0

# Database — REQUIRED, no default.
# Use localhost for local dev, db-service for Docker
DATABASE_URL=postgresql+asyncpg://fixmytext:fixmytext_dev@db-service:5432/fixmytext

# Optional: route through PgBouncer for connection pooling
# PGBOUNCER_URL=postgresql+asyncpg://fixmytext:fixmytext_dev@pgbouncer:6432/fixmytext

# PostgreSQL password (must match DATABASE_URL and docker-compose.yml)
POSTGRES_PASSWORD=fixmytext_dev

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# OpenTelemetry / Grafana Cloud (log shipping to Loki via OTLP HTTP)
# Get these from Grafana Cloud → Connections → Add new connection → OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
# Format: Authorization=Basic%20<base64-encoded-username:apikey>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=fixmytext-backend

# ── JWT algorithm dispatcher ────────────────────────────────────────────────
# JWT_ALGORITHM=RS256 — production cutover happened in Sprint 4. HS256 is the
# legacy fallback path; not used.
JWT_ALGORITHM=RS256

# ── Session cookie ──────────────────────────────────────────────
# Per-app, host-only HttpOnly cookie set by account-svc on successful auth.
# HMAC-SHA256 signed with SESSION_COOKIE_SECRET. The cookie is the
# cross-framework session marker (Vite + Next.js both send it).
# Generate: openssl rand -base64 48
SESSION_COOKIE_SECRET=
SESSION_COOKIE_NAME=fixmytext_session
SESSION_COOKIE_SECURE=false        # set to true in production (HTTPS only)
SESSION_COOKIE_MAX_AGE=604800      # 7 days
SESSION_COOKIE_DOMAIN=             # empty = host-only (intentional)

# ── Proxy trust ──────────────────────────────────────────────────────────────
# Comma-separated CIDRs or IPs trusted to supply X-Forwarded-For.
# Dev default "*" is safe because Kong is the only entry point on localhost.
# PRODUCTION: set to Kong's internal subnet CIDR (e.g. "172.20.0.0/16").
# The startup guard rejects "*" in production.
TRUSTED_PROXY_HOSTS=*

# ── Keycloak DEV realm (Velobits-Dev) — local development ───────────────────
# Local dev runs Keycloak at auth-dev.velobits.dev via Traefik + /etc/hosts.
# See README "Local development with subdomains" for /etc/hosts setup.
KEYCLOAK_URL=http://auth-dev.velobits.dev
KEYCLOAK_REALM=Velobits-Dev
KEYCLOAK_AUDIENCE=fixmytext-backend
KEYCLOAK_JWKS_URL=http://keycloak-dev:8080/realms/Velobits-Dev/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=fixmytext-backend  # used by send_verification_email redirect link

# Dedicated service account (created by bootstrap.sh — preferred over master admin creds).
# Generate: openssl rand -base64 32   # → KEYCLOAK_SERVICE_ACCOUNT_SECRET
KEYCLOAK_SERVICE_ACCOUNT_ID=account-svc
KEYCLOAK_SERVICE_ACCOUNT_SECRET=
# Keycloak will POST backchannel logout tokens to this URL on OIDC SLO.
# In dev: http://kong:8000/api/v1/auth/backchannel-logout (internal Docker address)
# In prod: https://api.velobits.dev/api/v1/auth/backchannel-logout
BACKCHANNEL_LOGOUT_URL=http://kong:8000/api/v1/auth/backchannel-logout

# Dev Keycloak admin + DB passwords.
# Generate strong values and store them in your password manager:
#   openssl rand -base64 32   # → KEYCLOAK_DEV_ADMIN_PASSWORD
#   openssl rand -base64 24   # → KEYCLOAK_DEV_DB_PASSWORD
KEYCLOAK_DEV_ADMIN_PASSWORD=
KEYCLOAK_DEV_DB_PASSWORD=

# Back-compat aliases — same values as KEYCLOAK_DEV_*, kept so docker-compose
# variable substitution still works for callers using the old names.
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_DEV_ADMIN_PASSWORD}
KEYCLOAK_DB_PASSWORD=${KEYCLOAK_DEV_DB_PASSWORD}

# ── Keycloak PROD realm (Velobits-Prod) — Sprint 9 provisioning ─────────────
# Placeholders; the prod Keycloak service is defined in docker-compose under
# the --profile prod gate. Local dev never runs Keycloak-Prod.
KEYCLOAK_PROD_URL=https://auth.velobits.dev
KEYCLOAK_PROD_REALM=Velobits-Prod
KEYCLOAK_PROD_JWKS_URL=https://auth.velobits.dev/realms/Velobits-Prod/protocol/openid-connect/certs
KEYCLOAK_PROD_ADMIN_PASSWORD=
KEYCLOAK_PROD_DB_PASSWORD=

# ── Social login providers (Sprint 4c) ──────────────────────────────────────
# These wire the Google/GitHub "Sign in with…" buttons on the Keycloak login
# page. The keycloak-bootstrap one-shot service reads them and registers the
# matching identity providers on the Velobits-Dev realm via the Admin API.
# Leave a pair BLANK to skip it — bootstrap.sh only provisions a provider when
# both its ID and SECRET are set, so the corresponding button simply won't
# appear (no error, graceful degradation).
#
# Google OAuth app — create at console.cloud.google.com
# Authorized redirect URI:
#   http://localhost:8080/realms/Velobits-Dev/broker/google/endpoint
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth app — create at github.com/settings/developers
# Authorization callback URL:
#   http://localhost:8080/realms/Velobits-Dev/broker/github/endpoint
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Keycloak admin username (default: admin; used by /auth/register Admin API calls)
KEYCLOAK_ADMIN=admin
