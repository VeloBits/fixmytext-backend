# Backend environment variables
# Copy this file to .env (git-ignored) and adjust values as needed.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Groq API key for AI-powered hashtag generation (free at console.groq.com)
GROQ_API_KEY=

# Auth / JWT — REQUIRED, no default. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Razorpay ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys for development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set up at https://dashboard.razorpay.com/app/webhooks
# Endpoint URL: https://yourdomain.com/api/v1/subscription/webhook
# Events: payment.captured, subscription.charged, subscription.cancelled, subscription.halted
RAZORPAY_WEBHOOK_SECRET=

# Free tier limits
FREE_USES_PER_TOOL_PER_DAY=3
DAILY_LOGIN_BONUS=1

# Frontend URL
FRONTEND_URL=http://localhost:3000

# ── Email (dev) ──────────────────────────────────────────────────────
#   https://myaccount.google.com/apppasswords). Sends to real inboxes.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=<16-char app password, no spaces>
EMAIL_FROM=FixMyText <you@gmail.com>

# Redis (optional — for distributed rate limiting; leave empty for in-memory)
REDIS_URL=redis://redis-service:6379/0

# Database — REQUIRED, no default.
# Use localhost for local dev, db-service for Docker
DATABASE_URL=postgresql+asyncpg://fixmytext:fixmytext_dev@db-service:5432/fixmytext

# PostgreSQL password (must match DATABASE_URL and docker-compose.yml)
POSTGRES_PASSWORD=fixmytext_dev

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# OpenTelemetry / Grafana Cloud (log shipping to Loki via OTLP HTTP)
# Get these from Grafana Cloud → Connections → Add new connection → OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
# Format: Authorization=Basic%20<base64-encoded-username:apikey>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=fixmytext-backend

# ── Keycloak + JWT algorithm dispatcher ────────────────────────────────────
# JWT_ALGORITHM controls how the monolith verifies tokens.
#   - HS256: legacy path, uses SECRET_KEY (current default)
#   - RS256: Keycloak path, uses KEYCLOAK_JWKS_URL (TODO — flip once
#            Keycloak takes over user identity)
JWT_ALGORITHM=HS256

# Keycloak runtime config (consumed when JWT_ALGORITHM=RS256).
# Currently dormant — the monolith still issues HS256 tokens.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fixmytext
KEYCLOAK_AUDIENCE=fixmytext-backend
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/fixmytext/protocol/openid-connect/certs

# Keycloak admin + DB passwords (used by docker-compose --profile dev).
# Generate strong values and store them in your password manager:
#   openssl rand -base64 32   # → KEYCLOAK_ADMIN_PASSWORD
#   openssl rand -base64 24   # → KEYCLOAK_DB_PASSWORD
# Production values are stored as GitHub repo secrets.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# ── Social login providers (Sprint 4c) ──────────────────────────────────────
# Google OAuth app — create at console.cloud.google.com
# Callback URL: http://localhost:8080/realms/fixmytext/broker/google/endpoint
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth app — create at github.com/settings/developers
# Callback URL: http://localhost:8080/realms/fixmytext/broker/github/endpoint
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Keycloak admin username (default: admin; used by /auth/register Admin API calls)
KEYCLOAK_ADMIN=admin
